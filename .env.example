# ====================================================================
# StokVigil AI Environment Variables Template
# Package ID: com.app.stokvigil
# ====================================================================

# Environment Mode (production / development)
ENVIRONMENT=production

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase Transaction Pooler (PgBouncer Port 6543, Shared IPv4, ?pgbouncer=true required)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Vault Encryption Secret (Fernet AES-256 base64 32-byte key)
ENCRYPTION_KEY=d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3c=

# Gemini AI Agent Key (Google AI Studio - Gemini 3.6 Flash Free Tier)
GEMINI_API_KEY=your-gemini-3.6-flash-api-key

# Firebase Cloud Messaging JSON Service Account String
FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "stokvigil-ai", ...}

# Telegram Bot API Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Secret Key to authorize 5-Minute Cron Scanner calls
CRON_SECRET_KEY=stokvigil_cron_default_secret_2026

# Whitelisted CORS Origins (Comma-separated list)
# In production, set to your live web domain:
# ALLOWED_ORIGINS=https://stokvigil-ai.vercel.app
# In local development, you can include localhost:
ALLOWED_ORIGINS=https://stokvigil-ai.vercel.app,http://localhost:3000,http://localhost:8000

# Backend URL of Google cloud run for GitHub Actions Cron
STOKVIGIL_BACKEND_URL=https://stokvigil-backend-xxxx.a.run.app


CRON_SECRET_KEY=cron_Secret

GOOGLE_SERVICES_JSON="{
  "project_info": {
    "project_number": "5895",
    "project_id": "stokvigil-ai", ....
}"

SUPABASE_ANON_KEY=your-supabase-aon-key

ALLOWED_ORIGINS= https://stokxx.vercel.app

TELEGRAM_WEBHOOK_SECRET=Your_Custom_Secret_Key_123