# ==============================================================================
# StokVigil AI — Complete Environment Variables Specification (.env.example)
# Application ID: com.app.stokvigil | High-Frequency Indian Market Surveillance
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: "production", "development", or "test"
# In "production", strict security is enforced (encryption key & cron token required).
ENVIRONMENT=production

# Application metadata (Optional overrides)
APP_NAME=StokVigil AI
PACKAGE_ID=com.app.stokvigil

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Your Supabase Project HTTPS endpoint (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public Client Anon Key (Used by Web Portal, Mobile App, and JWT validation fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Secret Key (REQUIRED by FastAPI Backend to bypass RLS for administrative jobs)
# ⚠️ WARNING: Never expose this key in client bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Transaction Connection Pooler URI (Supavisor / PgBouncer on Port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[REGION-HOST]:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 3. VAULT ENCRYPTION & BROKER CREDENTIAL PROTECTION
# ------------------------------------------------------------------------------
# 32-byte Fernet AES-256 base64 key used to encrypt ICICI Breeze API credentials in DB
# Generate in terminal: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-aes256-base64-key

# ------------------------------------------------------------------------------
# 4. SURVEILLANCE ENGINE & GEMINI AI REASONING
# ------------------------------------------------------------------------------
# Google AI Studio API Key for Gemini Flash AI catalyst analysis
# Obtain for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT NOTIFICATIONS (@BotFather)
# ------------------------------------------------------------------------------
# Telegram Bot HTTP API token created via @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Secret token header for validating incoming Telegram webhooks (X-Telegram-Bot-Api-Secret-Token)
# Set via: curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BACKEND_URL>/api/telegram/webhook&secret_token=<SECRET>"
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Base URL for the Next.js Web Portal / PWA (used for Telegram alert deep links to charts)
# e.g. https://app.stokvigil.com or http://localhost:3000
# When configured, Telegram alert buttons route directly to your Web PWA instead of fallback
WEB_PORTAL_URL=https://app.stokvigil.com

# ------------------------------------------------------------------------------
# 6. CRON SCHEDULER & ADMINISTRATIVE SECURITY
# ------------------------------------------------------------------------------
# Secret key to authenticate 5-minute market surveillance scans and reminders
# Must match the X-Cron-Secret header sent by GitHub Actions workflows
CRON_SECRET_KEY=your-cron-secret-key

# Optional alias for CRON_SECRET_KEY supported by backend configuration
CRON_SECRET=

# Dedicated secret key for inspecting administrative in-memory cache and telemetry
# Sent via X-Admin-Secret header to access /api/admin/metrics or restricted endpoints
ADMIN_SECRET_KEY=your-admin-secret-key

# ------------------------------------------------------------------------------
# 7. NETWORKING, BACKEND URL & CORS ORIGIN WHITELIST
# ------------------------------------------------------------------------------
# Public URL of your deployed FastAPI backend (e.g. on Google Cloud Run or Render)
STOKVIGIL_BACKEND_URL=https://your-backend.run.app

# Alternative alias for backend URL (used by Flutter mobile app & client build tools)
BACKEND_URL=https://your-backend.run.app

# Allowed CORS Origins (Comma-separated list or JSON array of allowed frontend URLs)
# In production, set to your exact domain(s) without trailing slashes
ALLOWED_ORIGINS=https://yourapp.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# 8. NEXT.JS WEB PORTAL CLIENT PROPERTIES (web_portal)
# ------------------------------------------------------------------------------
# Next.js requires the NEXT_PUBLIC_ prefix to expose variables to the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_BACKEND_URL=https://your-backend.run.app

# ------------------------------------------------------------------------------
# 9. FIREBASE CLOUD MESSAGING (FCM) & MOBILE APP BUILDS
# ------------------------------------------------------------------------------
# Firebase Admin SDK Service Account JSON for sending lock-screen push notifications
# Must be formatted as a single-line JSON string: {"type":"service_account",...}
FIREBASE_CREDENTIALS_JSON=

# Android Client google-services.json (Used by GitHub Actions .github/workflows/build_apk.yml)
# Store as a single-line JSON string or Base64-encoded string in GitHub Secrets
GOOGLE_SERVICES_JSON=

# Base URL for StokVigil Web Portal (used for Telegram alert deep-linking)
WEB_PORTAL_URL=https://app.stokvigil.com