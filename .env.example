# ====================================================================
# StokVigil AI Environment Variables Template
# Package ID: com.app.stokvigil
# ====================================================================

# Environment Mode
ENVIRONMENT=production

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vault Encryption Secret (Fernet AES-256 base64 32-byte key)
ENCRYPTION_KEY=d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3c=

# Gemini AI Agent Key (Google AI Studio - Gemini 3.6 Flash Free Tier)
GEMINI_API_KEY=your-gemini-3.6-flash-api-key

# Firebase Cloud Messaging JSON Service Account String
FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "stokvigil-ai", ...}

# Telegram Bot API Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Backend URL for GitHub Actions Cron
STOKVIGIL_BACKEND_URL=https://stokvigil-backend-xxxx.a.run.app
